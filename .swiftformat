# SwiftFormat 설정 - Momogo-iOS
# 규칙 참고: https://github.com/nicklockwood/SwiftFormat/blob/main/Rules.md

--swiftversion 5.10

# 검사/포맷 제외 경로
--exclude **/Derived,**/.build,Plugins

# 스타일 옵션
--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--commas inline
--trimwhitespace always
--stripunusedargs closure-only
--self remove
--importgrouping testable-bottom
